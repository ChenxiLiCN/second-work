# Datasets are transferred separately. Keep documentation and provenance only.
/data/*
!/data/README.md
!/data/manifests/
/third_party/pscan/datasets/

# Local experiment runs: indexes, materialized graphs, fixtures, output, logs,
# timing tables and saved Windows executables. Keep scripts at experiments/.
/experiments/*/
/server-results/
# This small reference table is an input to validate_v12.ps1/validate_v13.ps1.
!/experiments/v11/
/experiments/v11/*
!/experiments/v11/real-correctness.csv

